{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "bindings": [
        {
          "type": "service",
          "service": "mock-gov-api",
          "format": "url",
          "env": "GOV_SANDBOX_URL"
        }
      ]
    },
    "mock-gov-api": {
      "root": "backend",
      "runtime": "container",
      "entrypoint": "Dockerfile.mock"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
